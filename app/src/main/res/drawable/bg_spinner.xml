<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E1E30"/>
            <stroke android:width="1dp" android:color="#44FFFFFF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:right="12dp">
        <rotate android:fromDegrees="45" android:toDegrees="45"
            android:pivotX="70%" android:pivotY="40%">
            <shape android:shape="rectangle">
                <solid android:color="#FFFFFFFF"/>
                <size android:width="8dp" android:height="8dp"/>
            </shape>
        </rotate>
    </item>
</layer-list>
